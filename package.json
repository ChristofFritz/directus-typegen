{
  "name": "directus-typegen",
  "version": "2.0.1",
  "description": "Generate a TypeScript schema for the Directus SDK from a running Directus server or its OpenAPI spec",
  "keywords": [
    "directus",
    "directus-sdk",
    "typescript",
    "typegen",
    "codegen",
    "schema",
    "openapi"
  ],
  "homepage": "https://github.com/ChristofFritz/directus-typegen#readme",
  "bugs": {
    "url": "https://github.com/ChristofFritz/directus-typegen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristofFritz/directus-typegen.git"
  },
  "license": "MIT",
  "author": {
    "name": "Christof Fritz",
    "url": "https://www.npmjs.com/~nxtman"
  },
  "contributors": [
    "Elie Rotenberg (original directus-typescript-gen)"
  ],
  "type": "module",
  "bin": {
    "directus-typegen": "build/cli.mjs"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build/index.cjs",
    "build/index.cjs.map",
    "build/index.mjs",
    "build/index.mjs.map",
    "build/index.d.ts",
    "build/cli.mjs",
    "build/cli.mjs.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:esbuild && npm run lint && npm run build:tsc",
    "build:clean": "rm -rf build",
    "build:esbuild": "node esbuild.mjs",
    "build:tsc": "tsc --emitDeclarationOnly",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "npm run build && jest",
    "test:integration": "DIRECTUS_TEST_HOST=${DIRECTUS_TEST_HOST:-http://localhost:18055} npm test",
    "test:integration:docker": "docker compose -f docker-compose.test.yml up -d --wait && npm run test:integration; docker compose -f docker-compose.test.yml down -v",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@directus/sdk": "^25.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
